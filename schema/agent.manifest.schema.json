{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pit agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent"],
  "properties": {
    "agent": {
      "$ref": "#/$defs/name"
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "worker"],
        "properties": {
          "agent": {
            "$ref": "#/$defs/name"
          },
          "worker": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
